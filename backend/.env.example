GCP_PROJECT_ID=
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=

# Firestore: set these if Firestore lives in a different GCP project (e.g. personal account)
FIRESTORE_PROJECT_ID=
FIRESTORE_CREDENTIALS_FILE=

BQ_DATASET=nightmama
PUBSUB_TOPIC_SOS=sos-triggered

# SOS 通知（POST /sos → Pub/Sub → /internal/pubsub/sos → LINE 推播）。
# 這三個由 scripts/setup_pubsub_sos.sh 建好資源後印出來，正式環境由
# cloudbuild.yaml 的 deploy-api 帶上，本機通常留空即可 —— 留空時
# /internal/pubsub/sos 會一律回 503（fail closed），不影響其他端點。
LINE_CHANNEL_ACCESS_TOKEN=
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SA_EMAIL=
CORS_ORIGINS=["http://localhost:3000"]

# Optional: only used by scripts/geocode_cctv.py. Set this if you want the
# bulk one-off geocode run billed against a different GCP project/key than
# GOOGLE_MAPS_API_KEY above (e.g. to keep it off the shared project's quota).
GEOCODING_API_KEY=



