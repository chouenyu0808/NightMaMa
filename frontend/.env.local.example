# 複製成 .env.local 後填入實際值。.env.local 已被 gitignore。
#
# 命名規則（很重要）：
#   NEXT_PUBLIC_ 前綴 = 會被編進瀏覽器 bundle，任何訪客都看得到。
#   只有「本來就必須在前端執行」的 key 才可以用這個前綴。
#   其餘一律不加前綴，只在 API route / server 端讀取。

# --- 瀏覽器端可見 ---
# Google Maps JS SDK 必須在前端載入，因此無法隱藏。
# 請務必到 GCP Console 為這把 key 設定 HTTP referrer 限制與 API 白名單。
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_browser_key

# --- 僅伺服器端 ---
# Gemini：前端一律透過 /api/companion、/api/tts 代理，
# 語音通話則透過 /api/live-token 換發短期 ephemeral token。
GEMINI_API_KEY=your_gemini_api_key

# LINE Messaging API Channel Access Token。
# 僅用於 push 給使用者自己設定的緊急聯絡人；不提供 broadcast。
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# --- LINE Login（緊急聯絡人綁定）---
# 綁定必須由聯絡人本人授權：LINE Login 只回傳登入者自己的 userId，
# 沒有任何 API 能查出他人的 userId。
#
# Console 設定需求：
#   1. Login channel 必須與 Messaging API channel 在同一個 Provider
#      （userId 以 Provider 為範圍，跨 Provider 拿到的 ID 無法推播）
#   2. Callback URL 填 <APP_BASE_URL>/api/line/callback
#   3. Login channel 要連結官方帳號，bot_prompt 才能引導對方加好友
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id
LINE_LOGIN_CHANNEL_SECRET=your_line_login_channel_secret

# 邀請連結的簽章密鑰。與 LINE 無關，用來防止有人偽造邀請 token
# 把自己綁成他人的緊急聯絡人。正式環境請用：openssl rand -hex 32
INVITE_SIGNING_SECRET=change_me

# OAuth 回呼需要絕對網址
APP_BASE_URL=http://localhost:3000

# --- 選用 ---
# Python FastAPI 後端位址（未設定時前端會跳過後端呼叫）
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
