# 複製成 .env.local 後填入實際值。.env.local 已被 gitignore。
#
# 命名規則（很重要）：
#   NEXT_PUBLIC_ 前綴 = 會被編進瀏覽器 bundle，任何訪客都看得到。
#   只有「本來就必須在前端執行」的 key 才可以用這個前綴。
#   其餘一律不加前綴，只在 API route / server 端讀取。

# --- 瀏覽器端可見 ---
# Google Maps JS SDK 必須在前端載入，因此無法隱藏。
# 請務必到 GCP Console 為這把 key 設定 HTTP referrer 限制與 API 白名單。
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_browser_key

# --- 僅伺服器端 ---
# Gemini：前端一律透過 /api/companion、/api/tts 代理，
# 語音通話則透過 /api/live-token 換發短期 ephemeral token。
GEMINI_API_KEY=your_gemini_api_key

# LINE Messaging API Channel Access Token。
# 僅用於 push 給使用者自己設定的緊急聯絡人；不提供 broadcast。
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# --- 選用 ---
# Python FastAPI 後端位址（未設定時前端會跳過後端呼叫）
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
